  "evidenceGuards": {
    "titleDoesNotVerifyOutcome": true,
    "chatAdviceIsNotVerifiedInstruction": true,
    "audienceMayWaitOrHelpInsteadOfTease": true,
    "viewerLeakQuestionDoesNotVerifyLeak": true
  },
  "gameTextProvenance": "original_fiction_not_replay_quotation",
  "selection": {
    "defaultRows": 3,
    "normalRowsMin": 3,
    "normalRowsMax": 5,
    "quietRowsMin": 0,
    "quietRowsMax": 2,
    "minimumSpeakersWhenAtLeastTwoRows": 2,
    "functionalRolesAreNotPermanentPersonalityTypes": true,
    "recentBeatExclusionCount": 3,
    "fallback": "generic_context_safe_or_omit",
    "requiredKnowledgeBeforeSampling": true,
    "neverFetchRealChatAtRuntime": true,
    "runtimeGenerativeModelRequired": false,
    "empiricalMarkerRatesAreNotDrawWeights": true
  },
  "presentation": {
    "noExtraRequiredClicks": true,
    "allowInstantReveal": true,
    "allowCollapse": true,
    "speakerLabels": "fictional_game_ids_only",
    "sameBaseAssetCanRepresentMultipleIndividuals": true,
    "crowdDoesNotAlwaysShareOneOpinion": true,
    "realNicknamesOrProfilesUsed": false
  },
  "mechanics": {
    "dialogueAloneGrantsStatsCashOrExperience": false,
    "successLineRequiresCommittedOutcome": true,
    "callbacksRequireCurrentRunExperienceOrPromise": true,
    "outfitKnowledgeRequiresActualRevealScope": true,
    "mandatoryHintsAlsoShownInUI": true
  },
  "persistence": {
    "commitWith": "event_outcome",
    "saveFields": [
      "reactionBeatId",
      "templateId",
      "speakerIds",
      "lineOrder",
      "textVariables"
    ],
    "reloadOrJournalReplay": "reuse_committed_reaction_no_rng_or_reward_repeat"
  },
  "forcedEnding": {
    "partnerIs": "one_fictional_member_of_the_crowd",
    "existingPoolIsNotTotalFanPopulation": true,
    "crowdCelebratesSeparately": true,
    "existingTriggerAndSpouseSaveRulesUnchanged": true
  },
